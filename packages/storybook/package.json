{
  "name": "@volksverpetzer/storybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prestorybook": "pnpm --filter @volksverpetzer/design-tokens --filter @volksverpetzer/ui-web build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "pnpm --filter @volksverpetzer/design-tokens --filter @volksverpetzer/ui-web build",
    "build-storybook": "storybook build -o dist",
    "check:ts": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@volksverpetzer/design-tokens": "workspace:*",
    "@volksverpetzer/ui-web": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
