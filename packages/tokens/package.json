{
  "name": "@volksverpetzer/design-tokens",
  "version": "0.5.0",
  "description": "Shared design tokens (color, spacing, typography, radii, icon sizes, elevation) for Volksverpetzer apps, transformed per-platform via Style Dictionary.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Volksverpetzer/vvp_design_system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./rn/shared": {
      "types": "./dist/rn/shared/index.d.ts",
      "default": "./dist/rn/shared/index.js"
    },
    "./rn/volksverpetzer": {
      "types": "./dist/rn/volksverpetzer/index.d.ts",
      "default": "./dist/rn/volksverpetzer/index.js"
    },
    "./rn/mimikama": {
      "types": "./dist/rn/mimikama/index.d.ts",
      "default": "./dist/rn/mimikama/index.js"
    },
    "./css/volksverpetzer.css": "./dist/css/volksverpetzer.css",
    "./css/mimikama.css": "./dist/css/mimikama.css",
    "./css/volksverpetzer-brand.css": "./dist/css/volksverpetzer-brand.css",
    "./css/mimikama-brand.css": "./dist/css/mimikama-brand.css",
    "./css/*.css": "./dist/css/*.css",
    "./scss/volksverpetzer.scss": "./dist/scss/volksverpetzer.scss",
    "./scss/mimikama.scss": "./dist/scss/mimikama.scss",
    "./scss/radius.scss": "./dist/scss/radius.scss"
  },
  "scripts": {
    "build": "node build.mjs && node scripts/write-index-files.mjs && tsc -p tsconfig.rn.json",
    "check:ts": "tsc --noEmit -p tsconfig.rn.json"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.2",
    "typescript": "^6.0.3"
  }
}
