{
  "name": "vvp_design_system",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "check:ts": "pnpm -r check:ts",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "pnpm --filter @volksverpetzer/storybook storybook",
    "build-storybook": "pnpm --filter @volksverpetzer/storybook build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
